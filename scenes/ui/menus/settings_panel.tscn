[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/menus/SettingsPanel.cs" id="1_panel"]
[ext_resource type="Script" path="res://scripts/ui/MenuButton.cs" id="2_button"]
[ext_resource type="Script" path="res://scripts/ui/components/TabStrip.cs" id="3_tabs"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/option_cycler.tscn" id="4_cycler"]
