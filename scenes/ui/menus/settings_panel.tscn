[ext_resource type="PackedScene" path="res://scenes/ui/components/setting_toggle.tscn" id="6_toggle"]

[node name="SettingsPanel" type="PanelContainer"]
custom_minimum_size = Vector2(1100, 800)
theme_type_variation = &"MenuPanel"
script = ExtResource("1_panel")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Tabs" type="HBoxContainer" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1
script = ExtResource("3_tabs")
Tabs = PackedStringArray("Game", "Video", "Graphics", "Audio")
TabWidth = 210.0

