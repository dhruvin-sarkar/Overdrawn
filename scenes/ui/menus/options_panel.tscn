[node name="OptionsPanel" type="PanelContainer"]
custom_minimum_size = Vector2(640, 0)
theme_type_variation = &"MenuPanel"
script = ExtResource("1_panel")
SettingsScene = ExtResource("3_settings")
StatsScene = ExtResource("4_stats")
DeckScene = ExtResource("5_deck")
