[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/menus/OptionsPanel.cs" id="1_panel"]
[ext_resource type="Script" path="res://scripts/ui/MenuButton.cs" id="2_button"]
[ext_resource type="PackedScene" path="res://scenes/ui/menus/settings_panel.tscn" id="3_settings"]
