metadata/details = {
"joker_steady_hand": {"name": "Steady Hand", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+4 Mult if the played hand has no Aces"},
"joker_ace_high": {"name": "Ace High", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "Aces played as 11 give +8 Chips"},
"joker_low_roller": {"name": "Low Roller", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+1 Mult per card valued 6 or under in the played hand"},
"joker_face_value": {"name": "Face Value", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+10 Chips per face card in the played hand"},
"joker_small_time": {"name": "Small Time", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+20 Chips flat on every hand"},
"joker_careful_player": {"name": "Careful Player", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+3 Mult if you stood without ever hitting this hand"},
"joker_bold_play": {"name": "Bold Play", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+3 Mult if you hit at least twice this hand"},
"joker_even_money": {"name": "Even Money", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+$2 whenever a hand results in a push"},
"joker_warm_up": {"name": "Warm Up", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+1 Mult on each of the first 3 hands played per level"},
"joker_two_of_a_kind": {"name": "Two of a Kind", "kind": "joker", "rarity": "Common", "content_set": "base", "effect": "+15 Chips if your first two cards share the same rank"},
"joker_card_counter": {"name": "Card Counter", "kind": "joker", "rarity": "Uncommon", "content_set": "base", "effect": "Permanent +1 Chip scaling each time a 2–6 is played this run (caps at +50)"},
"joker_flush_table": {"name": "Flush Table", "kind": "joker", "rarity": "Uncommon", "content_set": "base", "effect": "+2 Mult per card of the majority suit in the played hand"},
"joker_split_decision": {"name": "Split Decision", "kind": "joker", "rarity": "Uncommon", "content_set": "base", "effect": "If you split this hand, retrigger this Joker's effects on the second half"},
